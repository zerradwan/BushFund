# BushFund MVP - copy to .env and adjust

# Server
PORT=4000
NODE_ENV=development

# Database (Postgres)
# Use with docker-compose: postgresql://bushfund:bushfund@localhost:5432/bushfund
DATABASE_URL=postgresql://bushfund:bushfund@localhost:5432/bushfund

# Frontend API base URL (for React app)
VITE_API_URL=http://localhost:4000

