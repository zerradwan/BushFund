# BushFund MVP - copy to .env and adjust

# Server
PORT=4000
NODE_ENV=development

# Database (Postgres). Or set USE_MEMORY_DB=1 to run without Postgres (no psql/Docker; data in-memory only).
# DATABASE_URL=postgresql://bushfund:bushfund@localhost:5432/bushfund
# USE_MEMORY_DB=1

# Frontend API base URL (for React app)
VITE_API_URL=http://localhost:4000

# TODO: When integrating real connectors, add (do not commit real keys):
# POLYMARKET_API_KEY=
# KALSHI_API_KEY=
